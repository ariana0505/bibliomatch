# Copia este archivo como .env para desarrollo. Nunca publiques el archivo .env real.
# MongoDB debe ser un replica set (también puede usarse MongoDB Atlas).
MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=bibliomatch

# Genera un valor con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo

# Si todavía no existe un administrador, se crea al iniciar la API.
ADMIN_APODO=administrador
ADMIN_PASSWORD=cambia-esto-por-una-contrasena-de-12-o-mas-caracteres

# Opcional: funciones de IA. Ambos valores son necesarios.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Solo para desarrollo local.
FLASK_DEBUG=1
